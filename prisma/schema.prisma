generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String?
  email          String         @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  accounts       Account[]
  ownedFamilies  Family[]       @relation("FamilyOwner")
  memberships    FamilyMember[] @relation("UserMemberships")
  invitesSent    Invite[]       @relation("InviteSender")
  uploadedPhotos Photo[]        @relation("PhotoUploader")
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Family {
  id          String           @id @default(cuid())
  name        String
  description String?
  shareToken  String           @unique @default(cuid())
  coverPhoto  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  ownerId     String
  owner       User             @relation("FamilyOwner", fields: [ownerId], references: [id])
  members     FamilyMember[]
  invites     Invite[]
  photos      Photo[]
  treeLayouts TreeNodeLayout[]
}

model FamilyMember {
  id                  String           @id @default(cuid())
  familyId            String
  fullName            String
  nickname            String?
  gender              Gender
  birthDate           DateTime?
  deathDate           DateTime?
  placeOfBirth        String?
  photoUrl            String?
  isDeceased          Boolean          @default(false)
  binBinti            String?
  icNumber            String?
  currentAddress      String?
  negeri              String?
  religion            Religion         @default(ISLAM)
  familyBranch        String?
  generationalTitle   String?
  occupation          String?
  biography           String?
  contactEmail        String?
  contactPhone        String?
  userId              String?
  role                FamilyRole       @default(VIEWER)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  family              Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user                User?            @relation("UserMemberships", fields: [userId], references: [id])
  photos              Photo[]
  relationshipsAsFrom Relationship[]   @relation("RelationshipFrom")
  relationshipsAsTo   Relationship[]   @relation("RelationshipTo")
  treeLayouts         TreeNodeLayout[]
}

model Relationship {
  id        String           @id @default(cuid())
  familyId  String
  fromId    String
  toId      String
  type      RelationshipType
  label     String?
  createdAt DateTime         @default(now())
  from      FamilyMember     @relation("RelationshipFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        FamilyMember     @relation("RelationshipTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([familyId])
}

model Photo {
  id           String        @id @default(cuid())
  familyId     String
  memberId     String?
  url          String
  thumbnailUrl String?
  caption      String?
  takenAt      DateTime?
  category     PhotoCategory @default(FAMILY)
  uploadedById String
  createdAt    DateTime      @default(now())
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member       FamilyMember? @relation(fields: [memberId], references: [id])
  uploader     User          @relation("PhotoUploader", fields: [uploadedById], references: [id])

  @@index([familyId])
  @@index([memberId])
}

model Invite {
  id        String       @id @default(cuid())
  familyId  String
  email     String
  role      FamilyRole   @default(VIEWER)
  token     String       @unique @default(cuid())
  status    InviteStatus @default(PENDING)
  senderId  String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sender    User         @relation("InviteSender", fields: [senderId], references: [id])

  @@index([familyId])
  @@index([email])
}

model TreeNodeLayout {
  id        String       @id @default(cuid())
  familyId  String
  memberId  String
  x         Float
  y         Float
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([familyId, memberId])
  @@index([familyId])
  @@index([memberId])
}

enum Gender {
  MALE
  FEMALE
}

enum Religion {
  ISLAM
  CHRISTIAN
  BUDDHIST
  HINDU
  OTHERS
}

enum RelationshipType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
}

enum FamilyRole {
  OWNER
  EDITOR
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum PhotoCategory {
  FAMILY
  WEDDING
  ANCESTRAL
  CHILDHOOD
  OTHERS
}
